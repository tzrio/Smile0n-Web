<script>
    // Selection state
    const state = {
      basePrice: 120,
      sizeMultiplier: 1,
      complexityMultiplier: 1,
      selectedDate: null,
      type: "Poster"
    };

    // DOM Elements
    const typeCards = document.querySelectorAll('.design-type-card');
    const sizeSelect = document.getElementById('sizeSelector');
    const complexityChips = document.querySelectorAll('.complexity-chip');
    const priceDisplay = document.getElementById('totalPrice');
    const summaryType = document.getElementById('summaryType');
    const summaryComplexity = document.getElementById('summaryComplexity');
    const summarySize = document.getElementById('summarySize');
    const summaryDeadline = document.getElementById('summaryDeadline');
    const calendarGrid = document.getElementById('calendarGrid');

    const monthSelect = document.getElementById('monthSelect');

const monthNames = [
    "Juni",
    "Juli",
    "Agustus",
    "September",
    "Oktober",
    "November",
    "Desember"
];

let currentMonth = 5; // Juni 2026
const currentYear = 2026;

    // Update Price and Summary + hidden form fields
    function updatePricing() {
      const total = state.basePrice * state.sizeMultiplier * state.complexityMultiplier;
      priceDisplay.innerText = `$${total.toFixed(2)}`;
      
      summaryType.innerText = state.type;
      summaryComplexity.innerText = state.complexityMultiplier === 1 ? 'Low' : (state.complexityMultiplier === 1.5 ? 'Medium' : 'High');
      summarySize.innerText = `x${state.sizeMultiplier}`;
      
      // Update hidden fields untuk form submission
      document.getElementById('hiddenJenisDesain').value = state.type;
      document.getElementById('hiddenUkuran').value = sizeSelect.options[sizeSelect.selectedIndex].text;
      
      if(!state.selectedDate) {
        summaryDeadline.innerText = "Select a date";
      }
    }

    // Type Selection
    typeCards.forEach(card => {
      card.addEventListener('click', () => {
        typeCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        state.basePrice = parseFloat(card.dataset.basePrice);
        state.type = card.dataset.type;
        updatePricing();
      });
    });

    // Size Selection
    sizeSelect.addEventListener('change', (e) => {
      state.sizeMultiplier = parseFloat(e.target.value);
      updatePricing();
    });

    // Complexity Selection
    complexityChips.forEach(chip => {
      chip.addEventListener('click', () => {
        complexityChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        state.complexityMultiplier = parseFloat(chip.dataset.multiplier);
        updatePricing();
      });
    });

    // Calendar Generation
   function generateCalendar() {

    const month = parseInt(monthSelect.value);

    const daysInMonth = new Date(
        currentYear,
        month + 1,
        0
    ).getDate();

    const firstDay = new Date(
        currentYear,
        month,
        1
    ).getDay();

    calendarGrid.innerHTML = "";

    // padding awal kalender
    for(let i = 0; i < firstDay; i++) {

        const empty = document.createElement("div");

        calendarGrid.appendChild(empty);
    }

    // generate tanggal
    for(let d = 1; d <= daysInMonth; d++) {

        const btn = document.createElement("button");

        btn.className =
            "h-10 w-full flex items-center justify-center rounded-lg border bg-surface-container-low border-outline-variant hover:border-primary transition-all";

        btn.innerHTML = d;

        btn.addEventListener("click", () => {

            document
                .querySelectorAll("#calendarGrid button")
                .forEach(b => {

                    b.classList.remove(
                        "bg-primary",
                        "text-white",
                        "border-primary"
                    );

                    b.classList.add(
                        "bg-surface-container-low"
                    );
                });

            btn.classList.remove(
                "bg-surface-container-low"
            );

            btn.classList.add(
                "bg-primary",
                "text-white",
                "border-primary"
            );

            state.selectedDate = d;

            summaryDeadline.innerText =
                `${monthNames[month-5]} ${d}, ${currentYear}`;

            // Update hidden field estimasi
            document.getElementById('hiddenEstimasi').value =
                `${monthNames[month-5]} ${d}, ${currentYear}`;
        });

        calendarGrid.appendChild(btn);
    }
}

monthSelect.addEventListener("change", () => {

    state.selectedDate = null;

    summaryDeadline.innerText =
        "Select a date";

    generateCalendar();
});
    // Initialize
    generateCalendar();
    updatePricing();
  </script>


</body></html>