<body class="bg-background text-on-surface font-body-md selection:bg-primary-fixed selection:text-on-primary-fixed min-h-screen flex flex-col">
<!-- TopNavBar -->
<header class="w-full top-0 sticky bg-surface-lowest border-b border-outline-variant z-50">
<nav class="flex justify-between items-center px-margin-desktop py-4 max-w-container-max-width mx-auto">
<a class="text-headline-md font-headline-md font-bold text-primary" href="/">SmileOn Lab</a>
<div class="hidden md:flex items-center gap-stack-lg">
