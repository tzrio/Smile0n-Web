<script>
        function toggleSection(id) {
            const content = document.getElementById(id);
            const icon = document.getElementById(id.split('-')[0] + '-icon');
            const isHidden = content.classList.contains('hidden');
            
            // Close all first for accordion effect
            ['qris-content', 'ewallet-content', 'bank-content'].forEach(secId => {
                document.getElementById(secId).classList.add('hidden');
                document.getElementById(secId.split('-')[0] + '-icon').textContent = 'expand_more';
            });

            if (isHidden) {
                content.classList.remove('hidden');
                icon.textContent = 'expand_less';
            }
        }

        // Initialize with QRIS open
        window.onload = () => toggleSection('qris-content');
    </script>


