              "spacing": {
                      "stack-md": "16px",
                      "container-max-width": "1280px",
                      "margin-mobile": "16px",
                      "stack-sm": "8px",
                      "gutter": "24px",
                      "stack-lg": "32px",
                      "base": "8px",
                      "margin-desktop": "32px"
              },
              "fontFamily": {
                      "display-lg": ["Inter"],
                      "display-lg-mobile": ["Inter"],
                      "headline-md": ["Inter"],
                      "body-md": ["Inter"],
