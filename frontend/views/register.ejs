<style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .form-input-focus:focus {
            outline: none;
            border-color: #1565C0;
            box-shadow: 0 0 0 2px rgba(21, 101, 192, 0.15);
        }
        .animate-subtle-drift {
            animation: drift 20s ease-in-out infinite alternate;
        }
        @keyframes drift {
            from { transform: translate(0, 0) scale(1); }
            to { transform: translate(20px, -20px) scale(1.05); }
        }
    </style>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">
<!-- TopNavBar -->
<nav class="w-full top-0 sticky z-50 bg-surface border-b border-outline-variant">
<div class="flex justify-between items-center px-margin-desktop py-4 max-w-container-max-width mx-auto">
<a href="/" class="font-headline-md text-headline-md font-bold text-primary hover:opacity-80 transition">SmileOn Lab</a>
<div class="hidden md:flex items-center gap-8">
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/">Home</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/gallery">Gallery</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/products">Products</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/recommendation">Recommendation</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/order">Order</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/orders">My Orders</a>
</div>
<div class="flex items-center gap-4">
<% if (locals.user) { %>
<span class="hidden md:block text-on-surface-variant font-body-sm"><%= user.email %></span>
<a href="/logout" class="text-primary font-label-md hover:underline">Logout</a>
<% } else { %>
<a href="/login" class="text-on-surface-variant font-label-md hover:underline">Login</a>
<a href="/register" class="text-primary font-bold border-b-2 border-primary pb-1 font-label-md hover:underline">Register</a>
<% } %>
</div>
</div>
</nav>
<main class="flex-grow flex items-center justify-center relative overflow-hidden px-margin-mobile md:px-margin-desktop py-stack-lg">
<!-- Atmospheric Background Element -->
<div class="absolute inset-0 pointer-events-none opacity-40 overflow-hidden">
<div class="absolute -top-[20%] -left-[10%] w-[60%] h-[60%] rounded-full bg-primary-fixed blur-[120px] animate-subtle-drift"></div>
<div class="absolute top-[40%] -right-[15%] w-[50%] h-[50%] rounded-full bg-surface-variant blur-[120px] animate-subtle-drift" style="animation-delay: -5s;"></div>
</div>
<!-- Registration Container -->
<div class="w-full max-w-[1000px] grid grid-cols-1 lg:grid-cols-2 bg-surface-container-lowest rounded-xl border border-outline-variant shadow-lg overflow-hidden relative z-10">
<!-- Branding/Visual Side (Desktop Only) -->
<div class="hidden lg:flex flex-col justify-between p-margin-desktop bg-surface-container-low border-r border-outline-variant">
<div class="space-y-stack-md">
<a class="block hover:opacity-80 transition-opacity" href="/">
<h1 class="font-headline-md text-headline-md font-bold text-primary">SmileOn Lab</h1>
</a>
<div class="flex items-center gap-stack-md">
<% if (locals.user) { %>
<a class="font-label-md text-label-md text-primary hover:underline transition-all" href="/logout">Logout</a>
<% } else { %>
<a class="font-label-md text-label-md text-primary hover:underline transition-all" href="/login">Login</a>
<% } %>
</div>
<div class="space-y-stack-sm">
<p class="font-headline-lg text-headline-lg text-on-surface">Precision Design, Delivered with Clarity.</p>
<p class="font-body-md text-body-md text-on-surface-variant">Join our ecosystem of high-velocity design experts and transform your brand identity with professional clarity.</p>
</div>
</div>
<div class="mt-stack-lg rounded-lg overflow-hidden border border-outline-variant aspect-square">
<img alt="Modern workspace" class="w-full h-full object-cover grayscale opacity-80 hover:grayscale-0 transition-all duration-700" data-alt="A sophisticated, high-end design studio workspace captured in a minimalist light-mode aesthetic. The scene features a clean white desk with a high-resolution monitor displaying abstract geometric design patterns. The environment is bathed in soft, natural daylight, emphasizing professional clarity and precision. The overall mood is calm, modern, and corporate, utilizing a palette of soft grays, whites, and deep primary blue accents." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCvI6sc7jKWwHsKCAlasoZ6J1BjdbbVE3O1gQtuzdzhMlfHGkqDjOguieAVgcWX3udXVzDcyxOhcPA7HKSI-x2pTcU8SziZPKH9pGP47fgaphizrnCNQ4FwS-accxDFISmr6YdPwST_96j7RQ00zUcW5pql0wMjanJz9ZoTPAbQJw4G3yA8nGYp5kr7DlA1DR3ReXU_LmYs7slAvPRh2iAiOWU6_k9UoypM-53EVzRVTLIfVhaetwPlgPUsRp6Wa4RN5XhPtZ1Bw_I">
</div>
<div class="flex items-center gap-stack-sm text-on-surface-variant">
<span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">verified_user</span>
<span class="font-label-md text-label-md">Secure enterprise-grade encryption</span>
</div>
</div>
<!-- Form Side -->
<div class="p-8 md:p-12 lg:p-16 flex flex-col justify-center">
<div class="mb-stack-lg lg:hidden">
<a href="/">
<h1 class="font-headline-md text-headline-md-mobile font-bold text-primary">SmileOn Lab</h1>
</a>
</div>
<header class="mb-stack-lg">
<h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-2">Create Account</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Join our platform to start your first project.</p>
</header>
<!-- Tampilkan flash messages (error/success) -->
<% if (locals.error_msg && error_msg.length > 0) { %>
  <% error_msg.forEach(function(msg) { %>
    <div class="bg-error-container text-on-error-container p-4 rounded-lg mb-4 font-body-sm"><%= msg %></div>
  <% }) %>
<% } %>
<% if (locals.success_msg && success_msg.length > 0) { %>
  <% success_msg.forEach(function(msg) { %>
    <div class="bg-surface-container-high text-primary p-4 rounded-lg mb-4 font-body-sm"><%= msg %></div>
  <% }) %>
<% } %>

<form action="/register" class="space-y-6" method="POST">
<!-- Nama Lengkap -->
<div class="space-y-stack-sm">
<label class="block font-label-md text-label-md text-on-surface-variant" for="nama">Nama Lengkap</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">person</span>
<input class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline/50 form-input-focus transition-all" id="nama" name="nama" placeholder="John Doe" required="" type="text">
</div>
</div>
<!-- Email -->
<div class="space-y-stack-sm">
<label class="block font-label-md text-label-md text-on-surface-variant" for="email">Email Address</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">mail</span>
<input class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline/50 form-input-focus transition-all" id="email" name="email" placeholder="name@company.com" required="" type="email">
</div>
</div>
<!-- Nomor Telepon -->
<div class="space-y-stack-sm">
<label class="block font-label-md text-label-md text-on-surface-variant" for="nomor_telepon">Nomor Telepon</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">phone</span>
<input class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline/50 form-input-focus transition-all" id="nomor_telepon" name="nomor_telepon" placeholder="0812-3456-7890" type="tel">
</div>
</div>
<!-- Alamat -->
<div class="space-y-stack-sm">
<label class="block font-label-md text-label-md text-on-surface-variant" for="alamat">Alamat</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">home</span>
<textarea class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline/50 form-input-focus transition-all" id="alamat" name="alamat" placeholder="Jl. Contoh No. 123, Jakarta" rows="2"></textarea>
</div>
</div>
<!-- Password -->
<div class="space-y-stack-sm">
<label class="block font-label-md text-label-md text-on-surface-variant" for="password">Password</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">lock</span>
<input class="w-full pl-10 pr-10 py-3 bg-white border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline/50 form-input-focus transition-all" id="password" name="password" placeholder="Min. 6 karakter" required="" type="password">
<button class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" type="button">
<span class="material-symbols-outlined text-[20px]">visibility</span>
</button>
</div>
</div>
<!-- Register Button -->
<button class="w-full py-4 bg-primary-container text-white font-label-md text-body-md font-bold rounded-lg hover:bg-primary transition-all active:scale-[0.98] shadow-sm flex items-center justify-center gap-2" type="submit">
                        Register
                        <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
</button>
</form>
<footer class="mt-stack-lg text-center">
<p class="font-body-sm text-body-sm text-on-surface-variant">
                        Already have an account? 
                        <a class="text-primary font-bold hover:underline transition-all" href="/login">Login</a>
</p>
</footer>
</div>
</div>
</main>
<!-- Footer Component Integration (Minimal version for transaction) -->
<footer class="w-full py-stack-md px-margin-desktop border-t border-outline-variant bg-surface-container-low mt-auto">
<div class="max-w-container-max-width mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
<span class="font-body-sm text-body-sm text-on-surface-variant">© 2024 <a class="hover:text-primary transition-colors" href="/">SmileOn Lab</a>. All rights reserved.</span>
<div class="flex gap-gutter flex-wrap justify-center">
<a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors" href="/gallery">Gallery</a>
<a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors" href="/recommendation">Recommendation</a>
<a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors" href="/order">Order</a>
<a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors" href="/login">Login</a>
<a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors" href="/media">Media</a>
<a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors" href="/payment">Payment</a>
</div>
</div>
</footer>
<script>
        // Micro-interactions for input fields
        const inputs = document.querySelectorAll('input');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                const icon = input.previousElementSibling;
                if (icon) icon.classList.add('text-primary');
            });
            input.addEventListener('blur', () => {
                const icon = input.previousElementSibling;
                if (icon) icon.classList.remove('text-primary');
            });
        });

        // Simple visibility toggle logic
        const toggleBtn = document.querySelector('button[type="button"]');
        const passwordInput = document.getElementById('password');
        if (toggleBtn && passwordInput) {
            toggleBtn.addEventListener('click', () => {
                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';
                toggleBtn.querySelector('span').textContent = isPassword ? 'visibility_off' : 'visibility';
            });
        }
    </script>


</body></html>