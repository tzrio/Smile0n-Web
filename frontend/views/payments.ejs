<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Payment Status | SmileOn Lab</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            background: "#f9f9ff", surface: "#f9f9ff",
            "surface-container": "#e7eeff", "surface-container-high": "#dee8ff",
            "surface-container-highest": "#d8e3fb", "surface-container-lowest": "#ffffff",
            "surface-variant": "#d8e3fb", "on-surface": "#111c2d",
            "on-surface-variant": "#424752", primary: "#004d99",
            "primary-container": "#1565c0", "on-primary": "#ffffff",
            secondary: "#5d5f5f", "secondary-container": "#dfe0e0",
            "on-secondary": "#ffffff", tertiary: "#644a00",
            "tertiary-fixed": "#ffdf9e", "on-tertiary-fixed": "#261a00",
            outline: "#727783", "outline-variant": "#c2c6d4",
            error: "#ba1a1a", "error-container": "#ffdad6",
            "on-error-container": "#93000a", "inverse-surface": "#263143",
          },
          fontFamily: {
            "body-md": ["Inter"], "body-sm": ["Inter"],
            "headline-md": ["Inter"], "headline-lg": ["Inter"],
            "label-md": ["Inter"], "label-sm": ["Inter"],
          },
          fontSize: {
            "body-md": ["16px", { lineHeight: "1.5", fontWeight: "400" }],
            "body-sm": ["14px", { lineHeight: "1.5", fontWeight: "400" }],
            "headline-md": ["24px", { lineHeight: "1.3", fontWeight: "600" }],
            "headline-lg": ["32px", { lineHeight: "1.25", fontWeight: "600" }],
            "label-md": ["14px", { lineHeight: "1", letterSpacing: "0.01em", fontWeight: "600" }],
            "label-sm": ["12px", { lineHeight: "1", fontWeight: "500" }],
          },
          spacing: {
            "stack-sm": "8px", "stack-md": "16px", "stack-lg": "32px",
            "gutter": "24px", "margin-desktop": "32px", "margin-mobile": "16px",
            "container-max-width": "1280px",
          },
          borderRadius: { lg: "0.5rem", xl: "0.75rem" },
        },
      },
    }
</script>
<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        vertical-align: middle;
    }
</style>
</head>
<body class="bg-surface text-on-surface font-body-md min-h-screen flex flex-col">
<!-- NavBar -->
<nav class="w-full top-0 sticky z-50 bg-surface border-b border-outline-variant">
<div class="flex justify-between items-center px-margin-desktop py-4 max-w-container-max-width mx-auto">
<a href="/" class="font-headline-md text-headline-md font-bold text-primary hover:opacity-80 transition">SmileOn Lab</a>
<div class="hidden md:flex items-center gap-8">
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/">Home</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/gallery">Gallery</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/products">Products</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/recommendation">Recommendation</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/order">Order</a>
<a class="text-primary font-bold border-b-2 border-primary pb-1 font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/orders">My Orders</a>
</div>
<div class="flex items-center gap-4">
<% if (locals.user) { %>
<span class="hidden md:block text-on-surface-variant font-body-sm"><%= user.email %></span>
<a href="/logout" class="text-primary font-label-md hover:underline">Logout</a>
<% } else { %>
<a href="/login" class="text-on-surface-variant font-label-md hover:underline">Login</a>
<a href="/register" class="bg-primary text-on-primary font-label-md py-2 px-5 rounded-lg hover:opacity-90 transition-all">Register</a>
<% } %>
</div>
</div>
</nav>

<main class="flex-1 max-w-container-max-width mx-auto px-margin-desktop py-stack-lg w-full">
<!-- Flash Messages -->
<% if (locals.error_msg && error_msg.length > 0) { %>
  <% error_msg.forEach(function(msg) { %>
    <div class="bg-error-container text-on-error-container p-4 rounded-lg mb-4 font-body-sm"><%= msg %></div>
  <% }) %>
<% } %>
<% if (locals.success_msg && success_msg.length > 0) { %>
  <% success_msg.forEach(function(msg) { %>
    <div class="bg-surface-container-high text-primary p-4 rounded-lg mb-4 font-body-sm"><%= msg %></div>
  <% }) %>
<% } %>

<!-- Back Nav -->
<div class="mb-stack-md">
<a href="/orders" class="inline-flex items-center gap-1 text-primary font-label-md hover:underline">
<span class="material-symbols-outlined">arrow_back</span>
Back to Orders
</a>
</div>

<h1 class="font-headline-lg text-headline-lg text-primary mb-stack-md">Payment Status</h1>

<% if (locals.payment && payment.id) { %>
<%
  let statusLabel = 'Unknown';
  let statusClass = 'bg-gray-100 text-gray-700';
  let statusIcon = 'help';
  let nextSteps = '';
  switch (payment.status_verifikasi) {
    case 'menunggu_verifikasi':
      statusLabel = 'Awaiting Verification';
      statusClass = 'bg-amber-100 text-amber-800';
      statusIcon = 'pending';
      nextSteps = 'Our team is reviewing your payment proof. You will receive a confirmation once it is verified.';
      break;
    case 'terverifikasi':
      statusLabel = 'Verified';
      statusClass = 'bg-green-100 text-green-800';
      statusIcon = 'verified';
      nextSteps = 'Payment confirmed! Your order is now being processed. You can track the order status in My Orders.';
      break;
    case 'ditolak':
      statusLabel = 'Rejected';
      statusClass = 'bg-red-100 text-red-800';
      statusIcon = 'cancel';
      nextSteps = 'Your payment proof was not accepted. Please upload a clearer image and try again.';
      break;
  }
%>
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-stack-lg shadow-sm max-w-2xl">
<div class="flex items-center justify-between mb-stack-md">
<div class="font-label-sm text-on-surface-variant uppercase tracking-wide">Payment #<%= payment.id %></div>
<span class="inline-flex items-center gap-1 px-4 py-1.5 rounded-full font-label-sm <%= statusClass %>">
<span class="material-symbols-outlined text-[18px]"><%= statusIcon %></span>
<%= statusLabel %>
</span>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-stack-md">
<div class="bg-surface-container rounded-lg p-4 border border-outline-variant">
<div class="font-label-sm text-on-surface-variant mb-1">Amount</div>
<div class="font-headline-md text-primary">
<% if (payment.jumlah) { %>Rp <%= Number(payment.jumlah).toLocaleString('id-ID') %><% } else { %>—<% } %>
</div>
</div>
<div class="bg-surface-container rounded-lg p-4 border border-outline-variant">
<div class="font-label-sm text-on-surface-variant mb-1">Method</div>
<div class="font-headline-md text-on-surface"><%= payment.metode_pembayaran || '—' %></div>
</div>
<div class="bg-surface-container rounded-lg p-4 border border-outline-variant">
<div class="font-label-sm text-on-surface-variant mb-1">Order ID</div>
<div class="font-headline-md text-on-surface">#<%= payment.order_id %></div>
</div>
<div class="bg-surface-container rounded-lg p-4 border border-outline-variant">
<div class="font-label-sm text-on-surface-variant mb-1">Payment Date</div>
<div class="font-headline-md text-on-surface">
<% if (payment.tanggal_pembayaran) { %>
<%= new Date(payment.tanggal_pembayaran).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
<% } else { %>—<% } %>
</div>
</div>
</div>

<% if (payment.bukti_pembayaran) { %>
<div class="mb-stack-md">
<div class="font-label-sm text-on-surface-variant mb-2">Payment Proof</div>
<a href="/uploads/payments/<%= payment.bukti_pembayaran %>" target="_blank" class="inline-flex items-center gap-2 text-primary font-label-md hover:underline">
<span class="material-symbols-outlined">open_in_new</span>
View Proof
</a>
</div>
<% } %>

<div class="bg-surface-container-high rounded-lg p-4 border border-outline-variant">
<div class="font-label-sm text-on-surface-variant mb-1">What happens next?</div>
<p class="font-body-md text-on-surface"><%= nextSteps %></p>
</div>

<% if (payment.status_verifikasi === 'ditolak') { %>
<div class="mt-stack-md text-right">
<a href="/payment?order_id=<%= payment.order_id %>" class="inline-flex items-center gap-2 bg-primary text-on-primary font-label-md py-3 px-6 rounded-lg hover:opacity-90 transition-all">
<span class="material-symbols-outlined">upload</span>
Upload New Proof
</a>
</div>
<% } else if (payment.status_verifikasi === 'menunggu_verifikasi') { %>
<div class="mt-stack-md text-right">
<a href="/orders" class="inline-flex items-center gap-2 text-primary font-label-md hover:underline">
<span class="material-symbols-outlined">visibility</span>
View Order Status
</a>
</div>
<% } %>
</div>
<% } else { %>
<!-- No payment found state -->
<div class="flex flex-col items-center justify-center py-stack-lg text-center max-w-xl mx-auto">
<div class="w-20 h-20 rounded-full bg-surface-container-high flex items-center justify-center mb-stack-md">
<span class="material-symbols-outlined text-4xl text-on-surface-variant">receipt_long</span>
</div>
<h2 class="font-headline-md text-headline-md text-primary mb-2">No payment found</h2>
<p class="font-body-md text-on-surface-variant max-w-md mb-stack-md">
<% if (locals.order_id) { %>
  We couldn't find a payment record for order #<%= order_id %>. Please upload your payment proof to continue.
<% } else { %>
  Enter an order ID to check your payment status, or browse your orders to find one.
<% } %>
</p>
<% if (locals.order_id) { %>
<a href="/payment?order_id=<%= order_id %>" class="inline-flex items-center gap-2 bg-primary text-on-primary font-label-md py-3 px-6 rounded-lg hover:opacity-90 transition-all">
<span class="material-symbols-outlined">upload</span>
Upload Payment Proof
</a>
<% } else { %>
<a href="/orders" class="inline-flex items-center gap-2 bg-primary text-on-primary font-label-md py-3 px-6 rounded-lg hover:opacity-90 transition-all">
<span class="material-symbols-outlined">list</span>
View My Orders
</a>
<% } %>
</div>
<% } %>
</main>

<!-- Footer -->
<footer class="w-full bg-surface-container-low border-t border-outline-variant mt-auto">
<div class="flex flex-col md:flex-row justify-between items-center px-margin-desktop py-stack-md max-w-container-max-width mx-auto gap-4">
<div class="flex flex-col gap-1">
<div class="font-label-md font-bold text-primary">SmileOn Lab</div>
<div class="font-body-sm text-on-surface-variant">© 2024 SmileOn Lab</div>
</div>
</div>
</footer>
</body></html>
