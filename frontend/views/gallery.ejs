<!DOCTYPE html><html class="light" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Portfolio | SmileOn Lab</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "tertiary-container": "#826100",
                    "on-secondary-fixed": "#1a1c1c",
                    "surface-variant": "#d8e3fb",
                    "primary-fixed-dim": "#a9c7ff",
                    "surface-container-lowest": "#ffffff",
                    "surface-container-highest": "#d8e3fb",
                    "on-secondary": "#ffffff",
                    "surface-container-low": "#f0f3ff",
                    "surface-dim": "#cfdaf2",
                    "on-tertiary-container": "#ffe2a7",
                    "secondary-fixed": "#e2e2e2",
                    "primary-fixed": "#d6e3ff",
                    "on-primary": "#ffffff",
                    "surface": "#f9f9ff",
                    "secondary-container": "#dfe0e0",
                    "error-container": "#ffdad6",
                    "on-tertiary-fixed-variant": "#5b4300",
                    "background": "#f9f9ff",
                    "inverse-primary": "#a9c7ff",
                    "on-secondary-fixed-variant": "#454747",
                    "tertiary-fixed-dim": "#fabd00",
                    "on-surface-variant": "#424752",
                    "on-primary-fixed": "#001b3d",
                    "primary": "#004d99",
                    "on-error-container": "#93000a",
                    "inverse-surface": "#263143",
                    "tertiary-fixed": "#ffdf9e",
                    "secondary-fixed-dim": "#c6c6c7",
                    "on-error": "#ffffff",
                    "on-secondary-container": "#616363",
                    "error": "#ba1a1a",
                    "on-primary-fixed-variant": "#00468c",
                    "surface-container": "#e7eeff",
                    "secondary": "#5d5f5f",
                    "on-background": "#111c2d",
                    "surface-container-high": "#dee8ff",
                    "surface-tint": "#005db7",
                    "outline-variant": "#c2c6d4",
                    "on-tertiary": "#ffffff",
                    "on-tertiary-fixed": "#261a00",
                    "tertiary": "#644a00",
                    "inverse-on-surface": "#ecf1ff",
                    "surface-bright": "#f9f9ff",
                    "primary-container": "#1565c0",
                    "outline": "#727783",
                    "on-surface": "#111c2d",
                    "on-primary-container": "#dae5ff"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "base": "8px",
                    "gutter": "24px",
                    "container-max-width": "1280px",
                    "margin-desktop": "32px",
                    "stack-sm": "8px",
                    "stack-md": "16px",
                    "stack-lg": "32px",
                    "margin-mobile": "16px"
            },
            "fontFamily": {
                    "headline-md": ["Inter"],
                    "body-sm": ["Inter"],
                    "label-md": ["Inter"],
                    "display-lg-mobile": ["Inter"],
                    "headline-lg": ["Inter"],
                    "display-lg": ["Inter"],
                    "label-sm": ["Inter"],
                    "body-md": ["Inter"],
                    "body-lg": ["Inter"]
            },
            "fontSize": {
                    "headline-md": ["24px", {"lineHeight": "1.3", "fontWeight": "600"}],
                    "body-sm": ["14px", {"lineHeight": "1.5", "fontWeight": "400"}],
                    "label-md": ["14px", {"lineHeight": "1", "letterSpacing": "0.01em", "fontWeight": "600"}],
                    "display-lg-mobile": ["36px", {"lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "headline-lg": ["32px", {"lineHeight": "1.25", "fontWeight": "600"}],
                    "display-lg": ["48px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "label-sm": ["12px", {"lineHeight": "1", "fontWeight": "500"}],
                    "body-md": ["16px", {"lineHeight": "1.5", "fontWeight": "400"}],
                    "body-lg": ["18px", {"lineHeight": "1.6", "fontWeight": "400"}]
            }
          },
        },
      }
    </script>
<style>
        body { font-family: 'Inter', sans-serif; }
        .portfolio-card:hover .portfolio-overlay { opacity: 1; }
        .gradient-mesh {
            background-color: #f9f9ff;
            background-image: 
                radial-gradient(at 0% 0%, rgba(21, 101, 192, 0.05) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(255, 193, 7, 0.05) 0px, transparent 50%);
        }
    </style>
</head>
<body class="bg-surface text-on-surface flex flex-col min-h-screen">
<!-- TopNavBar Component -->
<nav class="w-full top-0 sticky bg-surface-lowest dark:bg-inverse-surface border-b border-outline-variant dark:border-outline z-50">
<div class="flex justify-between items-center px-margin-desktop py-4 max-w-container-max-width mx-auto">
<a class="text-headline-md font-headline-md font-bold text-primary dark:text-inverse-primary hover:opacity-90 transition-opacity" href="/">SmileOn Lab</a>
<div class="hidden md:flex items-center gap-8">
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/">Home</a>
<a class="text-primary font-bold border-b-2 border-primary pb-1 font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/gallery">Gallery</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/products">Products</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/recommendation">Recommendation</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/order">Order</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="/orders">My Orders</a>
</div>
<div class="flex items-center gap-4">
<% if (locals.user) { %>
<span class="hidden md:block font-body-sm text-body-sm text-on-surface-variant"><%= user.email %></span>
<% if (locals.user && user.role === 'admin') { %>
<a class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors" href="/admin/orders">Admin</a>
<% } %>
<a class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors" href="/logout">Logout</a>
<% } else { %>
<a class="hidden md:block font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors" href="/login">Login</a>
<a class="bg-primary-container text-on-primary-container px-6 py-2 rounded-lg font-label-md text-label-md hover:opacity-90 active:scale-95 transition-all text-center" href="/register">Register</a>
<% } %>
</div>
</div>
</nav>
<main class="flex-grow gradient-mesh">
<!-- Flash Messages -->
<% if (locals.error_msg && error_msg.length > 0) { %>
  <% error_msg.forEach(function(msg) { %>
    <div class="bg-error-container text-on-error-container p-4 rounded-lg mb-4 font-body-sm max-w-container-max-width mx-auto mt-4"><%= msg %></div>
  <% }) %>
<% } %>
<% if (locals.success_msg && success_msg.length > 0) { %>
  <% success_msg.forEach(function(msg) { %>
    <div class="bg-surface-container-high text-primary p-4 rounded-lg mb-4 font-body-sm max-w-container-max-width mx-auto mt-4"><%= msg %></div>
  <% }) %>
<% } %>
<!-- Hero Section -->
<header class="py-stack-lg px-margin-mobile md:px-margin-desktop max-w-container-max-width mx-auto">
<div class="max-w-3xl">
<span class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container rounded-full text-primary font-label-sm text-label-sm mb-stack-md">
<span class="material-symbols-outlined text-[16px]">verified</span>
                    Our Work
                </span>
<h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-background mb-stack-md">Design Excellence Delivered.</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant mb-stack-lg">Explore how we help global brands stand out through precision-crafted visual identities, digital experiences, and high-impact print media.</p>
</div>
</header>
<!-- Category Filters -->
<section class="px-margin-mobile md:px-margin-desktop max-w-container-max-width mx-auto mb-stack-lg">
<div class="flex flex-wrap gap-stack-sm" id="portfolio-filters">
<button class="filter-btn px-6 py-2 rounded-full bg-primary text-on-primary font-label-md text-label-md shadow-sm transition-all" data-category="all">All Projects</button>
<button class="filter-btn px-6 py-2 rounded-full bg-surface-container-low text-on-surface-variant border border-outline-variant font-label-md text-label-md hover:bg-surface-container-high transition-all" data-category="branding">Branding</button>
<button class="filter-btn px-6 py-2 rounded-full bg-surface-container-low text-on-surface-variant border border-outline-variant font-label-md text-label-md hover:bg-surface-container-high transition-all" data-category="social">Social Media</button>
<button class="filter-btn px-6 py-2 rounded-full bg-surface-container-low text-on-surface-variant border border-outline-variant font-label-md text-label-md hover:bg-surface-container-high transition-all" data-category="print">Print</button>
</div>
</section>
<!-- Portfolio Grid (Bento Style) -->
<section class="px-margin-mobile md:px-margin-desktop max-w-container-max-width mx-auto mb-24">
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter" id="portfolio-grid">
<!-- Project Card 1: Branding -->
<div class="portfolio-item group relative overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest transition-all hover:shadow-lg animate-fade-in-up" data-category="branding">
<div class="aspect-[4/3] overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" data-alt="A sophisticated minimalist branding project for a high-end architecture firm. The image shows a sleek, dark navy business card with a metallic silver embossed logo resting on a textured gray stone surface. Soft daylight illuminates the clean lines and premium paper texture, reflecting a professional and modern corporate aesthetic consistent with SmileOn Lab's precision-focused design approach." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBzojzJAUrNtVzL8BlE_7z-bLMlJh65fMsm1yDHK78XvXKr1Lu7UwetC3EqXho53lk1YPtjWiXoSNQAdK7NlZTVSm1oVxR_SX5TsdwvF6J3MBrcJXYCFUIrQuvTLXcGlrZaQrgvblCQq0HWtWlkTuYKqaxICFNFTMHVRm7WtGwPD3k78Zsbe2fHbsZfnD0KBHCLplagRY7gVR2CLwWFH_Z3rtMFG_uSjzHQiw8Ga_opDKz98wonyk6F0YKv0dw3N7BTaxK_s9JIZTQ">
</div>
<div class="p-6">
<div class="flex justify-between items-start mb-2">
<span class="font-label-sm text-label-sm text-primary bg-primary-container/10 px-2 py-0.5 rounded">Branding</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">Lumina Architecture</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">A comprehensive visual identity refresh emphasizing structural precision and modern elegance.</p>
</div>
</div>
<!-- Project Card 2: Social Media -->
<div class="portfolio-item group relative overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest transition-all hover:shadow-lg animate-fade-in-up" data-category="social">
<div class="aspect-[4/3] overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" data-alt="A vibrant and energetic social media campaign mockup for a fitness lifestyle brand. The scene features a high-fidelity smartphone display showing a grid of dynamic Instagram posts with bold yellow accents and high-contrast photography of athletes. The lighting is energetic and bright, using a clean white background to make the colorful digital assets pop with clarity and professional appeal." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBv88D92AOWpqVXSlin5CSQcD3GYmT4EdJI_qnAId4rrQ86e244E9OUtLJ3nwUaF_-VImoNeRIh0RLNnXBKkl7CkHoKC_8nipLRfz8IWkDNzrE-FeWdaEAZ4pwBQShr4DwhXjrhECUnTbaZOmSx2SYu58OUmOr6FImr9BGSiKmcGBVjZ29AVRTWZ2c10ZgkToQNE8nTu1bVtBSsnoyVD8VuX45vzrsHSo3SGqd0dS7gFr_YcMna95tcxjlctnszWuKL8tIAbUatxCU">
</div>
<div class="p-6">
<div class="flex justify-between items-start mb-2">
<span class="font-label-sm text-label-sm text-primary bg-primary-container/10 px-2 py-0.5 rounded">Social Media</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">Pulse Fitness Campaign</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">High-engagement visual assets designed for a global fitness product launch on Instagram and TikTok.</p>
</div>
</div>
<!-- Project Card 3: Print -->
<div class="portfolio-item group relative overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest transition-all hover:shadow-lg animate-fade-in-up" data-category="print">
<div class="aspect-[4/3] overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" data-alt="An elegant editorial layout and print design for a luxury travel magazine. The photograph captures several thick, premium matte paper pages showing stunning landscape photography and perfectly kerned serif typography. The lighting is soft and natural, emphasizing the tactile quality of the paper and the sophisticated layout design typical of a high-end corporate design agency." src="https://lh3.googleusercontent.com/aida-public/AB6AXuA2VLRtxfLxLt4S61wfO9eZQXhjwr-B2x54KnCIJmXUmINzsBzwx2heF-zAyAvD6ID4P6wr7ljE0pLJ3hXqEWJokJBM8F6OLx4NtmerBDiGV3bv18ozvqym4pwcLkYKHTTRR7PO51Q1Prn3Ku82BXBNyjsgqeZRklL9q7caYvypeMdx9w2L4OxN36RqjbsTzWmISqggQlQ4IdXJIgcSPf_vDQWO9dhg2xZOxj9u3SyHiUUpEuK3Edx34xamDUAU0VaZlLpONija08c">
</div>
<div class="p-6">
<div class="flex justify-between items-start mb-2">
<span class="font-label-sm text-label-sm text-primary bg-primary-container/10 px-2 py-0.5 rounded">Print</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">Vantage Editorial</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">A 64-page premium quarterly magazine focusing on sustainable travel and minimalist living.</p>
</div>
</div>
<!-- Project Card 4: Branding -->
<div class="portfolio-item group relative overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest transition-all hover:shadow-lg animate-fade-in-up" data-category="branding">
<div class="aspect-[4/3] overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" data-alt="A modern tech startup branding suite featuring logo variations, typography guides, and app icons. The image is a flat lay on a clean desk with a MacBook and neatly arranged brand collateral. The color palette is dominated by professional blues and clean whites, projecting an image of reliability and technological advancement in a modern light-mode environment." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDzbeMHPDo5zTUlTubQHcw7oeGsjVdbb4Pnxxk8kFkB1Cp1vkXqmoMSSzD-3eHx6pk8kc5sq8R373JhzUmVA3lrRsBLkmOTVK2fxpv-8dyiGndoqqoXu_bBWEH11xrk-G0zC-zXh34MXzy6WdTfnz703-c6Y8liVpf25-8fP1tpkUzcs9ZOobVSQWC24dJB2YL_s53XK9siaE0fiQDaosxfPDM1JgDnRhwqHEWJ8sGowUTVS-aRoUSoJOg9sVzGp-EJugQRh3BkQAs">
</div>
<div class="p-6">
<div class="flex justify-between items-start mb-2">
<span class="font-label-sm text-label-sm text-primary bg-primary-container/10 px-2 py-0.5 rounded">Branding</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">Syncra Systems</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">Identity for a SaaS platform centered on connectivity and flow-based project management.</p>
</div>
</div>
<!-- Project Card 5: Social Media -->
<div class="portfolio-item group relative overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest transition-all hover:shadow-lg animate-fade-in-up" data-category="social">
<div class="aspect-[4/3] overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" data-alt="A collection of artistic social media templates for a coffee brand. The imagery uses warm, organic tones with stylish typography overlays. Each post is designed with a grid-first mentality, showcasing product shots and lifestyle imagery in a cohesive, aesthetic flow that enhances brand storytelling on social platforms." src="https://lh3.googleusercontent.com/aida-public/AB6AXuB5fHteJjfGdSZ2Yc2VOWeyT5ghJZTaLGauGeyWt-bsf3Kp9mfDgVxinUnm8qK8mFIMhOVTFABE8al-f76idjQPlT8lhzgzDtWl6yQs8PT7xv-NJlZCruBrPO-BwfKq-ZZk0ymrqRF769Ibn5bfIywQVZlQNc0eoBO6XULYcyd3rctvXhKaN0WJAK8kzKmCkWA8_QSg-vGHse4MpbyXET0-5G9cpQmG1s-2EoigeU5UXmspfrotD2NmAOBwisk4_iptzMX8LNSQYXk">
</div>
<div class="p-6">
<div class="flex justify-between items-start mb-2">
<span class="font-label-sm text-label-sm text-primary bg-primary-container/10 px-2 py-0.5 rounded">Social Media</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">Brew &amp; Co. Visuals</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">Story-driven content strategy and visual templates for a premium artisan coffee roastery.</p>
</div>
</div>
<!-- Project Card 6: Print -->
<div class="portfolio-item group relative overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest transition-all hover:shadow-lg animate-fade-in-up" data-category="print">
<div class="aspect-[4/3] overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" data-alt="High-quality packaging design for a luxury skincare line. The image shows minimalist white bottles with clean black sans-serif typography, presented on a marble plinth. The lighting is soft and studio-quality, highlighting the refined textures and premium feel of the physical packaging design for a high-end corporate brand." src="https://lh3.googleusercontent.com/aida-public/AB6AXuB-PzrQf68W22HNdV7IY9eQM3BBDVa3OM_y2kuKQL8u_vVjVmyamJGXEu-qY-Fsj5fga4uq6j3WexlSxeiaMymW1QSPsfzXvNMYS5JUOyUmAhLoZKQd4J3xVq_90Yt7p0lq6T4SXjhu1LySGsgV61zQq1nG1QUsoGsDs8eRvKpiZk4en6SRd7HzrgtWq_S00vdwqSLc8ENCNJhMa4Gec8X5tLQ8gWsBRB0ZjaHlivcstCdbcTI4iH-JXbhjgLj-I_vBx5APm9YDGdU">
</div>
<div class="p-6">
<div class="flex justify-between items-start mb-2">
<span class="font-label-sm text-label-sm text-primary bg-primary-container/10 px-2 py-0.5 rounded">Print</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">Aura Skincare</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">Minimalist packaging and collateral design for a premium dermatology-led skincare collection.</p>
</div>
</div>
</div>
</section>

<!-- Dynamic Gallery Section from API -->
<% if (locals.galleryItems && galleryItems.length > 0) { %>
<section class="px-margin-mobile md:px-margin-desktop max-w-container-max-width mx-auto mb-24">
  <div class="mb-stack-lg">
    <h2 class="font-headline-lg text-headline-lg text-primary">Portfolio Gallery</h2>
    <p class="font-body-md text-body-md text-on-surface-variant">Karya terbaru dari tim desain kami.</p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
    <% galleryItems.forEach(function(item) { %>
      <div class="portfolio-item group relative overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest transition-all hover:shadow-lg">
        <div class="aspect-[4/3] overflow-hidden">
          <% if (item.gambar) { %>
            <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="<%= item.gambar %>" alt="<%= item.judul %>">
          <% } else { %>
            <div class="w-full h-full bg-surface-container-high flex items-center justify-center">
              <span class="material-symbols-outlined text-4xl text-outline">image</span>
            </div>
          <% } %>
        </div>
        <div class="p-6">
          <div class="flex justify-between items-start mb-2">
            <span class="font-label-sm text-label-sm text-primary bg-primary-container/10 px-2 py-0.5 rounded"><%= item.kategori || 'Portfolio' %></span>
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-2"><%= item.judul %></h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant"><%= item.deskripsi || '' %></p>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- CTA Section -->
<section class="bg-primary text-on-primary py-stack-lg px-margin-mobile md:px-margin-desktop overflow-hidden relative">
<div class="max-w-container-max-width mx-auto flex flex-col md:flex-row justify-between items-center gap-stack-lg relative z-10">
<div class="max-w-2xl text-center md:text-left">
<h2 class="font-display-lg text-display-lg-mobile md:text-headline-lg mb-stack-sm text-white">Have a vision? Let’s bring it to life.</h2>
<p class="font-body-md text-body-md opacity-90">Ready to transform your brand with expert design? Our team is standing by to start your next project today.</p>
</div>
<div>
<a class="inline-block bg-[#FFC107] text-[#111c2d] px-8 py-4 rounded-lg font-headline-md text-headline-md font-bold hover:scale-105 transition-all shadow-lg active:scale-95" href="/order">Start a Project</a>
</div>
</div>
<!-- Subtle background effect -->
<div class="absolute top-0 right-0 w-1/2 h-full bg-white opacity-[0.03] skew-x-[-20deg] translate-x-20"></div>
</section>
</main>
<!-- Footer Component -->
<footer class="w-full mt-auto bg-surface-container-low dark:bg-inverse-surface border-t border-outline-variant dark:border-outline">
<div class="grid grid-cols-1 md:grid-cols-4 gap-gutter px-margin-desktop py-stack-lg max-w-container-max-width mx-auto">
<div class="flex flex-col gap-stack-md">
<div class="text-headline-sm font-headline-sm font-bold text-on-surface dark:text-inverse-on-surface">SmileOn Lab</div>
<p class="font-body-sm text-body-sm text-on-surface-variant dark:text-on-surface-variant">Expert design intervention for high-velocity brands. Precision, clarity, and approachability in every pixel.</p>
</div>
